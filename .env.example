# Copy this file to ".env" and paste your real key after the = sign.
# The .env file is git-ignored and never leaves the server. The key never
# passes through the phone app or through chat.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: the model the brain uses. Leave as-is unless you know you want another.
BRAIN_MODEL=claude-opus-5

# Your AirVend login — lets the app update machine inventory for you.
# Same account you sign into live.app.air-vend.com with. Server-only, never
# reaches the phone. Leave blank to disable the AirVend write-back.
AIRVEND_USER=
AIRVEND_PASS=

# Optional: port the server listens on (hosting providers set this automatically).
PORT=8123
